# Example environment variables (DO NOT COMMIT real secrets)
# Copy this file to .env and fill values locally (do NOT commit .env)

# PostgreSQL
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/pethotel
JDBC_DATABASE_USERNAME=postgres
JDBC_DATABASE_PASSWORD=postgres

# JWT secret - must be Base64-encoded 512-bit key (64 bytes)
# Generate with:
#   python3 -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(64)).decode())"
JWT_SECRET=

# Server
PORT=8080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Hikari pool
HIKARI_MAX_POOL_SIZE=10

# JWT expiration (ms)
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000


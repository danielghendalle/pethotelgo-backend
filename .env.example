# Copie este arquivo para .env e preencha os valores reais
# O arquivo .env NUNCA deve ser enviado para o GitHub

# ── Banco de dados ─────────────────────────────────────────────────────────────
POSTGRES_DB=pethoteldb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── CORS ───────────────────────────────────────────────────────────────────────
# IP público da VM Oracle Cloud ou domínio se tiver SSL
# Exemplo sem domínio:  http://123.456.789.0
# Exemplo com domínio:  https://meuapp.com,https://www.meuapp.com
CORS_ALLOWED_ORIGINS=http://SEU_IP_PUBLICO

# ── Firebase ───────────────────────────────────────────────────────────────────
# Gere o base64 com: base64 -w 0 firebase-service-account.json
FIREBASE_CREDENTIALS_BASE64=
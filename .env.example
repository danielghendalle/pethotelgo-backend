# Copie este arquivo para .env e preencha os valores reais
# O arquivo .env NUNCA deve ser enviado para o GitHub

# ── Banco de dados ─────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha_forte

# ── JWT ────────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Domínio(s) do seu frontend separados por vírgula
# Exemplo de produção: https://meuapp.com,https://www.meuapp.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Firebase ───────────────────────────────────────────────────────────────────
# Gere o base64 com: base64 -w 0 firebase-service-account.json
FIREBASE_CREDENTIALS_BASE64=

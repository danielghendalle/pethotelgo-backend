# Copie este arquivo para .env e preencha os valores reais
# O arquivo .env NUNCA deve ser enviado para o GitHub

# Banco de dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha

# CORS - domínio(s) do seu frontend separados por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Firebase
# Gere o base64 com: base64 -i firebase-service-account.json | tr -d '\n'
FIREBASE_CREDENTIALS_BASE64=

# Copie este arquivo para .env e preencha os valores reais
# O arquivo .env NUNCA deve ser enviado para o GitHub

# ── Banco de dados (MySQL) ─────────────────────────────────────────────────────
# Usado pelo container "db" do docker-compose.prod.yml / docker-compose.yml.
MYSQL_USER=pethotel
MYSQL_PASSWORD=troque-esta-senha

# ── CORS ───────────────────────────────────────────────────────────────────────
# Origem(ns) do frontend, separadas por vírgula. O navegador manda o header Origin
# mesmo com o Cloudflare Worker (mesma origem), então isto precisa bater.
# Deploy via Worker:   https://pethotelgo.SEU_USUARIO.workers.dev
# Sem domínio (Nginx): http://123.456.789.0
# Com domínio + SSL:   https://meuapp.com,https://www.meuapp.com
# Se ficar vazio, o backend usa allowedOriginPatterns=* (sem quebrar), mas o certo
# é setar a origem real.
CORS_ALLOWED_ORIGINS=https://pethotelgo.SEU_USUARIO.workers.dev

# ── JWT ────────────────────────────────────────────────────────────────────────
# Obrigatório em produção. Gere com: openssl rand -base64 64
# Precisa decodificar para pelo menos 32 bytes (256 bits) — exigência do HS256.
JWT_SECRET=

# Validade do access token em milissegundos (padrão: 1 hora)
JWT_EXPIRATION=3600000

# Validade do refresh token em milissegundos (padrão: 7 dias)
JWT_REFRESH_EXPIRATION=604800000
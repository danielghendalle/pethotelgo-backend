# Example environment variables (DO NOT COMMIT real secrets)
# Copy this file to .env and fill values locally (do NOT commit .env)

# PostgreSQL
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/pethotel
JDBC_DATABASE_USERNAME=postgres
JDBC_DATABASE_PASSWORD=postgres

# Firebase Configuration
# Option 1: Path to service account JSON file
firebase.credentials.path=src/main/resources/firebase-credentials.json

# Option 2: Application Default Credentials (ADC)
# Uncomment and set path if using ADC:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Server
PORT=8080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Hikari pool
HIKARI_MAX_POOL_SIZE=10

